# Keep this unset for local development to use public/media directly.
# In Vercel, set this to the public HTTPS root of the OSS bucket (no trailing /media).
# Do not place OSS AccessKey credentials in this file or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_MEDIA_BASE_URL=https://your-bucket.oss-cn-your-region.aliyuncs.com
